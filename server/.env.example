# RelayOne backend — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# Runtime
NODE_ENV=development
PORT=4000

# Postgres connection string (matches docker-compose defaults for local dev).
DATABASE_URL=postgres://relayone:relayone@localhost:5432/relayone

# CORS: origin of the static frontend (npx serve runs it on 4321).
CORS_ORIGIN=http://localhost:4321

# Sessions & verification
SESSION_TTL_DAYS=30
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5

# Object storage (provider-independent). "local" writes under STORAGE_LOCAL_DIR.
# Future providers (s3, gcs, r2) plug in behind the same interface.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./var/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads

# RelayOne Calls — WebRTC ICE servers.
# STUN is enough on a local network. For real NAT traversal add a TURN server:
#   TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
#   TURN_USERNAME=relayone
#   TURN_CREDENTIAL=super-secret
STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Rate limiting (requests per window) for auth/verification endpoints.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
